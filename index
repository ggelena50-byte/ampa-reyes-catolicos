<script>
// ── VOTACIÓN 1: SI/NO ──
let v1 = null;
function voto1(btn, op) {
  document.querySelectorAll('#vota .voto-btn').forEach(b => b.classList.remove('sel'));
  btn.classList.add('sel'); v1 = op;
  document.getElementById('btn-enviar1').disabled = false;
}
const votos1 = { si:62, no:22, quiza:16 };
function enviar1() {
  votos1[v1]++;
  const total = votos1.si + votos1.no + votos1.quiza;
  ['si','no','quiza'].forEach(k => {
    const p = Math.round(votos1[k]/total*100);
    document.getElementById('pct-'+k).textContent = p+'%';
    document.getElementById('fill-'+k).style.width = p+'%';
  });
  document.getElementById('ok1').classList.add('show');
  document.getElementById('btn-enviar1').disabled = true;
}

// ── VOTACIÓN 2: PROPUESTA ──
let v2 = null;
function voto2(btn, op) {
  document.querySelectorAll('#propuestas .voto-btn').forEach(b => b.classList.remove('sel'));
  btn.classList.add('sel'); v2 = op;
  document.getElementById('btn-enviar2').disabled = false;
}
function enviar2() {
  document.getElementById('ok2').classList.add('show');
  document.getElementById('btn-enviar2').disabled = true;
}

// ── ELEGIR PROPUESTA desde card ──
function elegirProp(btn, nombre) {
  document.querySelectorAll('.prop-sel-btn').forEach(b => {
    b.textContent = 'Me gusta esta ✓';
    b.style.fontWeight = '800';
    b.style.background = 'transparent';
  });
  btn.textContent = '✅ Seleccionada';
  btn.style.background = btn.style.color;
  btn.style.color = 'white';
}
</script>
