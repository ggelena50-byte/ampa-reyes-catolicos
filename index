<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Uniforme Escolar · CEIP Reyes Católicos</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,600;0,700;0,800;0,900;1,600&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════
   BRANDING AMPA CEIP REYES CATÓLICOS
   Basado en cartel Puertas Abiertas
   ═══════════════════════════════════ */
:root {
  --crema:      #FBF5E6;
  --crema-d:    #F0E8D0;
  --verde:      #3D6B35;
  --verde-l:    #5A8A4F;
  --verde-sage: #7BA05B;
  --melocoton:  #E8C4A0;
  --beige:      #D4B896;
  --beige-d:    #B89A78;
  --texto:      #2A2A2A;
  --texto-l:    #5a5a5a;
  --blanco:     #FFFFFF;

  /* uniformes */
  --verde-manzana: #6EC531;
  --navy:          #1B3A6B;
  --gris-uni:      #9EA3A8;
}

* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior: smooth; }

body {
  font-family: 'Nunito', sans-serif;
  background: var(--crema);
  color: var(--texto);
  overflow-x: hidden;
}

/* ── BLOBS DECORATIVOS ── */
.blob-fixed {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

/* ── NAV ── */
nav {
  position: sticky; top:0; z-index: 100;
  background: rgba(251,245,230,0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1.5px solid var(--beige);
  padding: 0.7rem 1.2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-logo {
  display: flex; align-items: center; gap: 0.5rem;
  font-weight: 900; font-size: 0.8rem; color: var(--verde);
}
.nav-logo span { font-size: 1.1rem; }
.nav-links {
  display: flex; gap: 0.3rem;
}
.nav-link {
  font-size: 0.65rem; font-weight: 800;
  color: var(--texto-l);
  text-decoration: none;
  padding: 0.3rem 0.6rem;
  border-radius: 50px;
  transition: all 0.2s;
}
.nav-link:hover { background: var(--verde); color: white; }

/* ── SECTIONS ── */
section {
  position: relative; z-index: 1;
  padding: 2.5rem 1.3rem;
}

/* ── HERO / PORTADA ── */
.hero {
  min-height: 100vh;
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  text-align: center;
  padding: 3rem 1.3rem 2rem;
  position: relative; overflow: hidden;
}
.hero-blob1 { position:absolute; width:280px; height:280px; background:#d4e8c2; opacity:0.45; border-radius:50%; top:-80px; right:-80px; }
.hero-blob2 { position:absolute; width:200px; height:200px; background:var(--melocoton); opacity:0.35; border-radius:50%; bottom:60px; left:-60px; }
.hero-blob3 { position:absolute; width:120px; height:120px; background:var(--beige); opacity:0.4; border-radius:50%; top:30%; right:10px; }

.hero-corona { font-size: 3rem; margin-bottom: 0.5rem; }
.hero-tag {
  display: inline-block;
  background: var(--verde);
  color: white;
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  padding: 0.3rem 0.9rem;
  border-radius: 50px;
  margin-bottom: 1rem;
}
.hero h1 {
  font-size: 2.4rem;
  font-weight: 900;
  color: var(--verde);
  line-height: 1.1;
  margin-bottom: 0.8rem;
}
.hero h1 em { font-style: normal; color: var(--verde-l); }
.hero p {
  font-size: 1rem;
  color: var(--texto-l);
  max-width: 340px;
  line-height: 1.6;
  margin-bottom: 2rem;
}

/* niños ilustrados hero */
.hero-kids {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
}

.scroll-hint {
  font-size: 0.68rem; color: var(--beige-d);
  font-weight: 700; letter-spacing: 0.1em;
  animation: bounce 2s infinite;
}
@keyframes bounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(6px)} }

/* ── RAZONES (estilo infografía) ── */
.razones-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.8rem;
  margin-top: 1.2rem;
}
.razon-card {
  border-radius: 20px;
  padding: 1.2rem 1rem;
  position: relative;
}
.razon-card:nth-child(1) { background: #c8ddb8; }
.razon-card:nth-child(2) { background: var(--melocoton); }
.razon-card:nth-child(3) { background: var(--beige); }
.razon-card:nth-child(4) { background: #b8cfe8; }

.razon-ico { font-size: 1.6rem; margin-bottom: 0.4rem; }
.razon-titulo { font-size: 0.82rem; font-weight: 900; color: var(--texto); margin-bottom: 0.3rem; line-height: 1.2; }
.razon-txt { font-size: 0.68rem; color: var(--texto-l); line-height: 1.45; }

/* ── SECTION TITLES ── */
.s-titulo {
  font-size: 1.6rem;
  font-weight: 900;
  color: var(--verde);
  line-height: 1.2;
  margin-bottom: 0.3rem;
}
.s-sub {
  font-size: 0.8rem;
  color: var(--texto-l);
  margin-bottom: 1.5rem;
  line-height: 1.5;
}
.s-bg-crema { background: var(--crema); }
.s-bg-blanco { background: var(--blanco); }
.s-bg-verde  { background: var(--verde); }

/* ── VOTACIÓN ── */
.voto-card {
  background: white;
  border-radius: 24px;
  padding: 1.5rem 1.2rem;
  box-shadow: 0 4px 24px rgba(0,0,0,0.07);
  margin-bottom: 1rem;
}
.voto-pregunta {
  font-size: 1.1rem;
  font-weight: 900;
  color: var(--verde);
  margin-bottom: 1.2rem;
  line-height: 1.3;
}
.voto-opciones {
  display: flex; flex-direction: column; gap: 0.7rem;
}
.voto-btn {
  width: 100%;
  padding: 0.9rem 1.2rem;
  border-radius: 16px;
  border: 2.5px solid var(--beige);
  background: var(--crema);
  font-family: 'Nunito', sans-serif;
  font-size: 0.9rem;
  font-weight: 800;
  color: var(--texto);
  cursor: pointer;
  text-align: left;
  transition: all 0.2s;
  display: flex; align-items: center; gap: 0.8rem;
}
.voto-btn:hover { border-color: var(--verde); background: #eef5e8; }
.voto-btn.sel  { border-color: var(--verde); background: var(--verde); color: white; }
.voto-btn .ico { font-size: 1.3rem; flex-shrink: 0; }

.voto-enviar {
  width: 100%;
  margin-top: 1rem;
  padding: 1rem;
  border-radius: 16px;
  border: none;
  background: var(--verde);
  color: white;
  font-family: 'Nunito', sans-serif;
  font-size: 1rem;
  font-weight: 900;
  cursor: pointer;
  transition: transform 0.2s, background 0.2s;
}
.voto-enviar:hover { background: var(--verde-l); transform: scale(1.02); }
.voto-enviar:disabled { background: var(--beige); color: var(--beige-d); cursor: default; transform: none; }

.voto-ok {
  display: none;
  background: #eef5e8;
  border: 2px solid var(--verde-sage);
  border-radius: 16px;
  padding: 1rem;
  text-align: center;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--verde);
  margin-top: 0.8rem;
}
.voto-ok.show { display: block; animation: fadeup 0.4s ease; }

/* barra resultados */
.resultados { margin-top: 1.2rem; }
.res-item { margin-bottom: 0.8rem; }
.res-label { display:flex; justify-content:space-between; font-size:0.75rem; font-weight:800; color:var(--texto); margin-bottom:0.3rem; }
.res-bar { height:10px; background:var(--crema-d); border-radius:50px; overflow:hidden; }
.res-fill { height:100%; border-radius:50px; transition: width 1s ease; }

@keyframes fadeup { from{opacity:0;transform:translateY(8px)} to{opacity:1} }

/* ── PROPUESTAS UNIFORME ── */
.propuesta {
  background: white;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(0,0,0,0.07);
  margin-bottom: 1.2rem;
}
.prop-header {
  padding: 1.2rem 1.3rem 1rem;
  display: flex; align-items: flex-start; justify-content: space-between;
}
.prop-nombre { font-size: 1.1rem; font-weight: 900; }
.prop-tag {
  font-size: 0.6rem; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.1em;
  padding: 0.25rem 0.6rem; border-radius: 50px;
}
.prop-desc { font-size: 0.75rem; color: var(--texto-l); margin-top: 0.2rem; }

.prop-figures {
  padding: 0.5rem 1rem 1rem;
  display: flex; justify-content: center; gap: 1.5rem;
  background: var(--crema);
}
.prop-fig { display:flex; flex-direction:column; align-items:center; gap:0.3rem; }
.prop-fig-label { font-size:0.58rem; font-weight:800; color:var(--texto-l); text-transform:uppercase; letter-spacing:0.06em; }

.prop-colores {
  padding: 0.8rem 1.3rem;
  display: flex; gap: 0.5rem; align-items: center;
}
.col-chip {
  display:flex; align-items:center; gap:0.3rem;
  font-size:0.62rem; font-weight:700; color:var(--texto-l);
}
.col-dot { width:18px; height:18px; border-radius:50%; border:1.5px solid rgba(0,0,0,0.08); flex-shrink:0; }

.prop-footer {
  padding: 0.8rem 1.3rem;
  border-top: 1.5px solid var(--crema-d);
  display: flex; align-items:center; justify-content:space-between;
}
.prop-precio { font-size:0.75rem; color:var(--texto-l); }
.prop-precio strong { font-size:1rem; color:var(--texto); }

.prop-sel-btn {
  padding: 0.5rem 1.1rem;
  border-radius: 50px;
  border: 2px solid currentColor;
  background: transparent;
  font-family: 'Nunito',sans-serif;
  font-size: 0.75rem;
  font-weight: 800;
  cursor: pointer;
  transition: all 0.2s;
}

/* ── FOOTER AMPA ── */
.ampa-footer {
  background: var(--verde);
  padding: 2rem 1.3rem;
  text-align: center;
  position: relative; overflow:hidden;
}
.ampa-footer::before {
  content:'';position:absolute;top:-60px;left:-60px;
  width:180px;height:180px;
  background:rgba(255,255,255,0.05);border-radius:50%;
}
.ampa-footer .logo-ampa {
  font-size:2rem; margin-bottom:0.5rem;
}
.ampa-footer h3 {
  font-size:0.85rem; font-weight:900; color:white;
  letter-spacing:0.1em; text-transform:uppercase;
}
.ampa-footer p { font-size:0.7rem; color:rgba(255,255,255,0.6); margin-top:0.3rem; }
.ampa-footer a { color:rgba(255,255,255,0.8); font-weight:700; }

/* ── VINILO PREVIEW ── */
.vinilo-mini {
  display:inline-flex; flex-direction:column; align-items:center; gap:0.05rem;
  line-height:1.2;
}
</style>
</head>
